        "print(f'Teacher Model Size: {teacher_size:.2f} MB')\n",
        "print(f'Size Reduction: {teacher_size / student_size:.2f}x')\n",
        "print(f'Final Test Accuracy: {test_accs[-1]:.2f}%')"
