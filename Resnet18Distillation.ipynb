        "# Profiling\n",
        "def get_model_size(model):\n",
        "    param_size = 0\n",
        "    for param in model.parameters():\n",
        "        param_size += param.nelement() * param.element_size()\n",
        "    buffer_size = 0\n",
        "    for buffer in model.buffers():\n",
        "        buffer_size += buffer.nelement() * buffer.element_size()\n",
        "    return (param_size + buffer_size) / (1024 ** 2)\n",
        "\n",
        "# Inference latency\n",
        "student.eval()\n",
        "teacher.eval()\n",
        "\n",
        "test_batch = next(iter(test_loader))\n",
        "test_input = test_batch[0][:1].to(device)  # Take first image\n",
        "num_inferences = 100\n",
        "\n",
        "# Warm up\n",
        "for _ in range(10):\n",
        "    with torch.no_grad():\n",
        "        _ = student(test_input)\n",
        "        _ = teacher(test_input)\n",
        "\n",
        "# Profile student\n",
        "student_times = []\n",
        "with torch.no_grad():\n",
        "    for _ in range(num_inferences):\n",
        "        torch.cuda.synchronize()\n",
        "        start = time.perf_counter()\n",
        "        _ = student(test_input)\n",
        "        torch.cuda.synchronize()\n",
        "        end = time.perf_counter()\n",
        "        student_times.append((end - start) * 1000)\n",
        "\n",
        "# Profile teacher\n",
        "teacher_times = []\n",
        "with torch.no_grad():\n",
        "    for _ in range(num_inferences):\n",
        "        torch.cuda.synchronize()\n",
        "        start = time.perf_counter()\n",
        "        _ = teacher(test_input)\n",
        "        torch.cuda.synchronize()\n",
        "        end = time.perf_counter()\n",
        "        teacher_times.append((end - start) * 1000)\n",
        "\n",
        "student_latency = np.mean(student_times)\n",
        "teacher_latency = np.mean(teacher_times)\n",
        "student_size = get_model_size(student)\n",
        "teacher_size = get_model_size(teacher)\n",
        "\n",
        "torch.save(student.state_dict(), 'student_distilled.pth')\n",
        "print('Model saved to student_distilled.pth')\n",
        "\n",
        "print('\\n=== RESULTS ===')\n",
